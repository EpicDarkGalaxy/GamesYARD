/* =========================================================================
   GAMESYARD THEME - DARK MODE
   ========================================================================= */

/* Base Window Styling */
QWidget {
    background-color: #121212;
    color: #e0e0e0;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
}

/* Sidebar & Navigation */
#side_bar {
    background-color: #0d0d0d;
    border-right: 1px solid #333333;
}

#side_bar QToolButton {
    background-color: transparent;
    color: #aaaaaa;
    border: none;
    padding: 12px;
    font-weight: bold;
    text-align: left;
}

#side_bar QToolButton:hover {
    color: #ffffff;
    background-color: #1e90ff;
}

/* Main Content Area */
#main_entry {
    background-color: #121212;
}

#header {
    background-color: #121212;
    border-bottom: 1px solid #333333;
}

/*Download Area*/
#download_page_root_container {
    border: 1px solid #333333;
    border-radius: 10px;
    padding: 15px;
}


/* Requirements & Info Panels */
#requirements_container, #hero_frame {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 10px;
    padding: 15px;
}

/*Home Catalog Styling*/
#section_title {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 20px;
    margin-bottom: 10px;
    padding-left: 5px;
}

#home_section_list_view {
    border: none;
}

/* Scrollbars */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* Buttons */
QPushButton {
    background-color: #1e90ff;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover { background-color: #4faaff; }
QPushButton:pressed { background-color: #0066cc; }
QPushButton:disabled { background-color: #333333; color: #777777; }

/* Input Fields */
QLineEdit {
    background-color: #0d0d0d;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px 12px;
    color: #ffffff;
}

/* Scrollbar styling */
QScrollBar:vertical {
    background: #121212;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #333333;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background: #121212;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #333333;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #1e90ff;
}

QScrollBar::handle:vertical:hover {
    background: #1e90ff;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
}
