/* src/ui/style.qss */

/* Global window background */
QWidget {
    background-color: #1e1e1e;
    color: #ffffff;
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
}

/* Specific Label Styling */
QLabel[styleClass="link-label"]:hover {
    /* Define the border color so it actually shows up */
    border: 2px solid slategrey;
    border-radius: 3px;
    /* Add a background so the hover state is obvious */
    background-color: #333333;
    /* Optional: change the text color to stand out */
    color: #ffffff;
}


/* Button Styling */
QPushButton {
    background-color: #333333;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #444444;
    border-color: #777777;
}

QPushButton:pressed {
    background-color: #222222;
}

/* List Widget Styling */
QListWidget {
    background-color: #1e1e1e;
    border: none;
    /* This adds space around the grid */
    padding: 10px;
}

QListWidget::item {
    /* Adds spacing between grid items */
    margin: 10px;
    background-color: #2a2a2a;
    border-radius: 8px;
    padding: 5px;
}

QListWidget::item:hover {
    background-color: #3d3d3d;
}

QListWidget::item:selected {
    background-color: slategray;
}

/* Scrollbar styling for a consistent dark theme */
QScrollBar:vertical {
    background: #555555;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: lightslategray;
    border: 1px solid darkgray;
    border-radius: 5px;
}
