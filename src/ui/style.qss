/* src/ui/style.qss */

/* Global Window styling */
QWidget {
    background-color: #121212;
    color: #e0e0e0;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 14px;
}

/* Sidebar and Main Content areas */
#side_bar {
    background-color: #121212; /* Slightly darker than main */
    border-right: 1px solid #252525;
}

#req_label {
    color: #1e90ff; /* Accent color */
    font-weight: bold;
    padding-right: 20px; /* Space between label and value */
}

/* The Value labels */
QLabel {
    color: #cccccc;
}


#main_entry {
    background-color: #181818; /* The "Store" canvas */
}

/* Make the Search bar look modern */
#line_search_bar {
    background-color: #0d0d0d;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 5px 15px;
}

#side_bar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 8;
    padding: 12px 0px; /* Use vertical padding, remove hardcoded horizontal padding */
    font-size: 14px;
    color: #aaaaaa;
    text-align: center;
    /* This centers the button's content internally (icon or text) */
    qproperty-toolButtonStyle: ToolButtonTextBesideIcon;
}

#side_bar QToolButton:hover {
    color: #ffffff;
    background-color: #1e90ff;
}


/* Padding for the detail page container */
#details_page {
    padding: 30px;
}

/* Style the Hero area */
#hero_frame {
    background-color: #1e1e1e;
    border-radius: 12px;
    padding: 15px;
}

/* Make title stand out */
#game_title {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
}

/* Metadata color */
#game_metadata {
    color: #888888;
    margin-bottom: 20px;
}

#info_area {
    border-radius: 12px;
}

/* 1. Make the requirements container pop */
#requirements_container {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 10px;
}

/* 2. Styling the headers within the box */
#requirements_container QLabel[is_header="true"] {
    color: #1e90ff; /* Accent blue for the labels */
    font-weight: bold;
    font-size: 13px;
    text-transform: uppercase;
}

/* 3. General text styling */
#requirements_container QLabel {
    color: #cccccc;
    font-size: 13px;
    padding: 2px;
}

#provider-btn {
    background-color: transparent;
    border: 1px solid #333333;
    color: #e0e0e0;
    font-weight: bold;
    border-radius: 4px;
    padding: 6px 12px;
}

#provider-btn:hover {
    border: 1px solid #1e90ff;
    background-color: rgba(30, 144, 255, 0.1);
}


/* Game Card Widget Styling */
#game-card {
    background-color: #1e1e1e;
    border: 1px solid #252525;
    border-radius: 10px;
}

#game-card:hover {
    border: 1px solid #1e90ff;
    background-color: #222222;
    border-radius: 3px;
}

#card-label {
    background-color: transparent;
    font-weight: bold;
    text-align: center;
}

#card-overlay {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 transparent,
        stop: 1 rgba(0, 0, 0, 240)
    );
    color: #ffffff;
    padding: 12px 10px;
    font-weight: bold;
    font-size: 13px;
    /* Round the bottom corners of the label to match the card */
/*    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;*/
}

#card-overlay:hover {
    background: rgba(0, 0, 0, 180);
}


/* Button Styling */
QPushButton {
    background-color: #1e90ff;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QToolButton:hover {
    background-color: #4faaff;
}

QToolButton:pressed {
    background-color: #0066cc;
}

QPushButton:hover {
    background-color: #4faaff;
}

QPushButton:pressed {
    background-color: #0066cc;
}

QPushButton:disabled {
    background-color: #333333;
    color: #777777;
}

/* QScrollArea Styling */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* Scrollbar styling */
QScrollBar:vertical {
    background: #121212;
    width: 8px;
    margin: 0px;
}

QScrollBar:horizontal {
    background: #121212;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #333333;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #1e90ff;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
}

/* QProgressBar styling */
QProgressBar {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
    height: 24px;
}

QProgressBar::chunk {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #1e90ff, stop: 1 #63b3ff
    );
    border-radius: 5px;
}
